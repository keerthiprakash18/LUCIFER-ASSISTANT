# Copy to .env. No secrets are required for local tools, imports or PDF rendering.
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# All local data and credentials remain under this project.
DATA_DIR=.local
# Gemini is the default new-workspace provider; OpenAI remains supported when explicitly selected.
# FlagshipRouter is not implemented here and must not receive credentials.
MODEL_PROVIDER=gemini
OPENAI_API_KEY=
# Set an actual model available to your API account and compatible with Responses.
OPENAI_MODEL=
# The server POSTs to {OPENAI_BASE_URL}/responses. Do not provide a Chat Completions-only base URL.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional Gemini Developer API fallback configuration. Use the owner form instead of putting a key here when possible.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional local-only Ollama configuration. No model is downloaded by LUCIFER.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
# Research uses the provider's web_search tool only when enabled and supported.
ENABLE_WEB_SEARCH=false
TELEGRAM_BOT_TOKEN=
# A destination is not connected until the owner verifies a one-time code in Telegram.
# For Chromium downloads: keep the browser inside this project.
PLAYWRIGHT_BROWSERS_PATH=.local/browsers
