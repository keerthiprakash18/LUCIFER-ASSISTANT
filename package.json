{
  "name": "lucifer-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "setup": "tsx server/setup.ts",
    "doctor": "tsx server/doctor.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/browser.ts",
    "test:provider-ui": "tsx tests/provider-ui.ts",
    "test:live-ui": "tsx tests/live-provider-ui.ts",
    "companion": "tsx companion/index.ts",
    "browser:install": "tsx scripts/browser-install.ts",
    "browser:linux": "tsx scripts/browser-linux.ts",
    "test:windows": "tsx tests/native-windows.ts",
    "native:build": "tsx scripts/native-build.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/noto-sans-tamil": "^5.2.0",
    "@google/genai": "2.27.0",
    "@napi-rs/canvas": "^1.0.10",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "fastify": "^5.12.5",
    "lucide-react": "^0.468.0",
    "ollama": "0.6.4",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
